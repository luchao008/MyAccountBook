{
  "name": "my-account-book",
  "version": "1.0.0",
  "description": "个人记账应用 (Midway.js 4 + MariaDB 10)",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "dev": "mw dev --ts",
    "build": "mw build -c",
    "start": "NODE_ENV=production node bootstrap.js",
    "test": "mw test --ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,test}/**/*.ts\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\"",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/data-source.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/data-source.ts",
    "seed": "ts-node src/seed/index.ts",
    "seed:all": "ts-node src/seed/index.ts --all",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "4.2.3",
    "@midwayjs/core": "4.2.3",
    "@midwayjs/jwt": "4.2.3",
    "@midwayjs/koa": "4.2.3",
    "@midwayjs/logger": "^4.0.1",
    "@midwayjs/swagger": "^4.2.3",
    "@midwayjs/typeorm": "4.2.3",
    "@midwayjs/validate": "4.2.3",
    "bcryptjs": "^2.4.3",
    "mysql2": "^3.9.7",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@midwayjs/cli": "2.1.1",
    "@midwayjs/mock": "4.2.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.70.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
