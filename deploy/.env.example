# 复制为 .env 后修改（.env 不要提交进 git）

# 数据库 root 密码（必填，设一个强密码）
DB_PASSWORD=change-me-please

# 数据库名
DB_NAME=account_book

# JWT 签名密钥（必填，设一个随机长串）
JWT_SECRET=change-me-to-a-random-string

# App 前端对外端口（浏览器访问 http://NAS_IP:该端口）
WEB_PORT=8080

# 中台（admin）对外端口
ADMIN_PORT=8081

# MariaDB 数据在群晖上的存放路径（**绝对路径**，需先建好并给写权限）
DATA_DIR=/volume1/docker/account-book/data
