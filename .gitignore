# iOS 构建产物：xcodebuild 的 -derivedDataPath 指向这里
# （默认路径 ~/Library/Developer/Xcode/DerivedData 会被沙箱拒绝写入，
#   表现成 BUILD FAILED，其实不是代码问题）
.tmp-ios-build/
